# Copy to .env and adjust. All values are optional.
INITIAL_CAPITAL=100000
SLIPPAGE_BPS=3
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=2.0
DEFAULT_STOP_LOSS_PCT=1.0
DEFAULT_TAKE_PROFIT_PCT=2.0
ALLOW_SHORT=true
# 1.0 = no leverage. 0.2 = 5x intraday leverage (riskier).
MARGIN_RATE=1.0

# Set this before deploying publicly: start/stop/backtest then need the X-API-Key header.
APP_API_KEY=
CORS_ORIGINS=http://localhost:3000
